; Proyecto de prueba de interaccion local con MediaPipe.
config_version=5

[application]
config/name="Hack4Edu - Cuarto de ciencias"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Cuarto de ciencias con recorrido y mesa de pruebas con MediaPipe"

[display]
window/size/viewport_width=1100
window/size/viewport_height=720
window/size/window_width_override=1100
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.075, 1)
